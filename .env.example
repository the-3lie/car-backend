# Base PostgreSQL en ligne (Neon, Supabase, Railway...)
# Neon : DATABASE_URL = lien "pooled", DIRECT_URL = lien "direct"
# Si ton hébergeur n'a qu'un seul lien, mets le même dans les deux.
DATABASE_URL="postgresql://user:motdepasse@hote/base?sslmode=require"
DIRECT_URL="postgresql://user:motdepasse@hote/base?sslmode=require"

JWT_SECRET="remplace-par-une-longue-phrase-aleatoire"
PORT=3000
# Adresse du frontend (pour CORS). Plusieurs adresses : sépare par des virgules


# Compte admin créé par "npm run seed"
ADMIN_NOM="admin"
ADMIN_MOT_DE_PASSE="change-moi"
FRONTEND_URL="http://localhost:5173"